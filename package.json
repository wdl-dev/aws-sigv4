{
  "name": "@wdl-dev/aws-sigv4",
  "version": "3.0.2",
  "description": "Small zero-dependency AWS SigV4 signer for web-standard runtimes and S3-compatible storage.",
  "keywords": [
    "aws",
    "sigv4",
    "signature-v4",
    "s3",
    "lambda"
  ],
  "homepage": "https://github.com/wdl-dev/aws-sigv4#readme",
  "bugs": {
    "url": "https://github.com/wdl-dev/aws-sigv4/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wdl-dev/aws-sigv4.git"
  },
  "license": "Apache-2.0",
  "author": "Sean Consulting OÜ",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:pack": "npm run build && node scripts/check-pack.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/unit/*.test.js",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include=dist/index.js --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=95 test/unit/*.test.js",
    "test:workerd": "npm run build && workerd test test/workerd/config.capnp",
    "test:integration:s3": "npm run build && node --test --test-isolation=none test/s3-integration.test.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "globals": "^17.10.0",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "workerd": "1.20260811.1"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "workerd@1.20260811.1": true
  }
}
